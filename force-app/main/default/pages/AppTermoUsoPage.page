<apex:page controller="APP_TermosUsoVFController" 
           sidebar="false" 
           showHeader="false" 
           applyHtmlTag="false" 
           applyBodyTag="false"
           docType="html-5.0"
           action="{!redirecionarSeNaoPrecisaAceitar}">
    
    <apex:form id="formTermos">
        <div class="container-termos" style="display: {!IF(exibirTermos, 'flex', 'none')};">
            <div class="termos-content">
                <!-- Cabeçalho com Logo -->
                <div class="logo-container">
                    <img src="{!URLFOR($Resource.APP_LogoOncoclinicas)}" class="logo-img" alt="Logo"/>
                </div>
                
                
                <!-- Painel de Abas -->
                <apex:tabPanel switchType="client" 
                              rendered="{!OR(mostrarTermoUso, mostrarPoliticaPrivacidade)}"
                              id="tabPanelTermos"
                              styleClass="tab-panel-custom">
                    
                    <!-- Aba Termos de Uso -->
                    <apex:tab label="Termos e Condições de Uso" 
                              rendered="{!mostrarTermoUso}"
                              styleClass="tab-custom">
                        <div class="termo-container">
                            <apex:outputText escape="false" value="{!conteudoTermo}" />
                        </div>
                    </apex:tab>
                    
                    <!-- Aba Política de Privacidade -->
                    <apex:tab label="Política de Privacidade" 
                              rendered="{!mostrarPoliticaPrivacidade}"
                              styleClass="tab-custom">
                        <div class="termo-container">
                            <apex:outputText escape="false" value="{!conteudoPolitica}" />
                        </div>
                    </apex:tab>
                </apex:tabPanel>
                
                <!-- Mensagem quando não há termos para exibir -->
                <apex:outputPanel rendered="{!AND(NOT(mostrarTermoUso), NOT(mostrarPoliticaPrivacidade))}">
                    <div class="no-terms-message">
                        <p>Todos os termos foram aceitos.</p>
                    </div>
                </apex:outputPanel>
                
                <!-- Checkbox de Aceite -->
                <div class="checkbox-container">
                    <apex:inputCheckbox value="{!aceiteMarcado}" id="chkAceite">
                        <apex:actionSupport event="onchange" reRender="formTermos"/>
                    </apex:inputCheckbox>
                    <label for="chkAceite" class="checkbox-label">{!checkboxLabel}</label>
                </div>
                
                <!-- Botões de Ação -->
                <div class="buttons-container">
                    <apex:commandButton action="{!sair}" 
                                       value="Sair" 
                                       styleClass="btn btn-secondary"
                                       immediate="true"
                                       oncomplete="redirectToLogout()"/>
                    
                    <apex:commandButton action="{!aceitarTermos}" 
                                       value="Acessar" 
                                       disabled="{!NOT(aceiteMarcado)}" 
                                       styleClass="btn btn-primary"
                                       reRender="messages,formTermos"
                                       id="btnAcessar"/>
                </div>
            </div>
        </div>
    </apex:form>
    
    <style>
        /* Estilos Gerais */
        body {
            font-family: 'Salesforce Sans', Arial, sans-serif;
            background-color: white; /* Changed to white */
            margin: 0;
            padding: 0;
            height: 100vh;
            overflow: hidden;
            color: #3c3c3c;
        }
        
        /* Container Principal */
        .container-termos {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            box-sizing: border-box;
            background-color: white; /* Changed to white */
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 1000;
        }
        
        .termos-content {
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            width: 100%;
            max-width: 800px;
            max-height: 90vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        /* Cabeçalho */
        .logo-container {
            padding: 25px 0;
            text-align: center;
            background: linear-gradient(to right, #007d77, #6328b4); /* Added gradient */
            border-bottom: 1px solid #eaeaea;
        }
        
        .logo-img {
            max-height: 50px;
            height: auto;
            max-width: 80%;
        }
        
        /* Mensagens */
        .custom-messages {
            padding: 0 25px;
        }
        
        /* Painel de Abas */
        .tab-panel-custom {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        .tab-custom {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        /* Container do Termo */
        .termo-container {
            flex: 1;
            overflow-y: scroll; /* Changed to scroll */
            padding: 20px 25px;
            line-height: 1.6;
            font-size: 14px;
            max-height: 400px; /* Added max-height for scroll */
        }
        
        .termo-container::-webkit-scrollbar {
            width: 8px;
        }
        
        .termo-container::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }
        
        .termo-container::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 4px;
        }
        
        .termo-container::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }
        
        /* Checkbox */
        .checkbox-container {
            padding: 15px 25px;
            border-top: 1px solid #eaeaea;
            background: #f9f9f9;
            display: flex;
            align-items: center;
        }
        
        .checkbox-label {
            margin-left: 10px;
            cursor: pointer;
            user-select: none;
            font-size: 14px;
        }
        
        /* Botões */
        .buttons-container {
            display: flex;
            gap: 15px;
            padding: 15px 25px;
            background: #ffffff;
            border-top: 1px solid #eaeaea;
        }
        
        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            flex: 1;
            text-align: center;
            font-size: 14px;
        }
        
        .btn-primary {
            background-color: #0176d3;
            color: white;
        }
        
        .btn-primary:hover {
            background-color: #014486;
        }
        
        .btn-primary:disabled {
            background-color: #c9c9c9;
            cursor: not-allowed;
            opacity: 0.7;
        }
        
        .btn-secondary {
            background-color: #ffffff;
            color: #0176d3;
            border: 1px solid #0176d3;
        }
        
        .btn-secondary:hover {
            background-color: #f3f9fe;
        }
        
        /* Mensagem sem termos */
        .no-terms-message {
            text-align: center;
            padding: 40px 25px;
            color: #2e844a;
            font-weight: bold;
            font-size: 16px;
        }
        
        /* Estilos das abas */
        .tabNav {
            background: #f3f3f3;
            border-bottom: 1px solid #dddbda;
        }
        
        .tabNav .tab {
            padding: 12px 20px;
            margin: 0;
            border: none;
            border-bottom: 3px solid transparent;
            color: #003366; /* Dark blue color for tabs */
        }
        
        .tabNav .tab.activeTab {
            background: white;
            border-bottom: 3px solid #0176d3;
            color: #003366; /* Dark blue color for active tab */
            font-weight: bold;
        }
        
        /* Specific style for "Termos e Condições" tab */
        .tabNav .tab:first-child {
            color: #003366; /* Dark blue color */
        }
    </style>
    
    <script>
        function redirectToLogout() {
            window.location.href = '/secur/logout.jsp';
        }

        document.addEventListener('DOMContentLoaded', function() {
            var checkbox = document.querySelector('[id$="chkAceite"]');
            var btnAcessar = document.querySelector('[id$="btnAcessar"]');
            
            if(checkbox && btnAcessar) {
                checkbox.addEventListener('change', function() {
                    btnAcessar.disabled = !this.checked;
                    btnAcessar.classList.toggle('btn-primary-disabled', !this.checked);
                });
            }
            
            // Forçar redimensionamento inicial
            setTimeout(function() {
                window.dispatchEvent(new Event('resize'));
            }, 300);
        });
    </script>
</apex:page>